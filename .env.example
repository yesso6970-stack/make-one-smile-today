# Neon pooled URL (-pooler host) for the Vercel/Next.js runtime.
DATABASE_URL=

# Neon direct URL for Drizzle migrations and administrative tasks.
DATABASE_URL_UNPOOLED=

# Public canonical URL used by metadata and sharing features.
NEXT_PUBLIC_APP_URL=https://make-one-smile-today.vercel.app

# Free Google OAuth credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=https://make-one-smile-today.vercel.app
NEXTAUTH_SECRET=

# Optional paid OpenAI Responses API. Without this key, the free local coach remains active.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
